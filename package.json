{
  "name": "ccdph",
  "productName": "CCDPH",
  "version": "0.4.1",
  "description": "Claude Code 桌面工作台：本地多会话终端、浏览器自动化与 MCP 集成的 Electron 应用",
  "author": {
    "name": "ZIO123-DOT",
    "email": "zio123@users.noreply.github.com"
  },
  "homepage": "https://github.com/ZIO123-DOT/CCDPH---agent-",
  "type": "module",
  "main": "desktop.cjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node tests/run.mjs",
    "check": "node tests/syntax-check.mjs",
    "integrity": "node scripts/generate-runtime-integrity.mjs",
    "build": "electron-builder --publish never",
