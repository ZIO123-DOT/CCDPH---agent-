    "@playwright/mcp": "0.0.80",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "playwright": "1.63.0"
  }
}
